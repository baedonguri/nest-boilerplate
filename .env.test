# app e2e (pnpm test:e2e): separate database, migrated and seeded by test/global-setup.ts
NODE_ENV=test
APP_PORT=3999
API_PREFIX=api
APP_CORS_ORIGINS=*

DATABASE_TYPE=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=secret
DATABASE_NAME=app_test
DATABASE_SYNCHRONIZE=false

AUTH_JWT_SECRET=e2e_jwt_secret
AUTH_JWT_TOKEN_EXPIRES_IN=15m
AUTH_REFRESH_SECRET=e2e_refresh_secret
AUTH_REFRESH_TOKEN_EXPIRES_IN=30d
AUTH_UNIFORM_ERRORS=false
LOG_LEVEL=warn
