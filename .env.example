NODE_ENV=development
APP_PORT=3000
APP_NAME="NestJS API"
API_PREFIX=api
APP_CORS_ORIGINS=*

# docker compose up -d (host port 5433)
DATABASE_TYPE=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=secret
DATABASE_NAME=app_dev
DATABASE_SYNCHRONIZE=false
# per app instance; budget: instances x pool + migrations/admin <= Postgres max_connections - reserved
DATABASE_POOL_MAX=10
DATABASE_SSL_ENABLED=false
DATABASE_REJECT_UNAUTHORIZED=false

# replace both secrets before deploying (production refuses these placeholders)
AUTH_JWT_SECRET=secret
AUTH_JWT_TOKEN_EXPIRES_IN=15m
AUTH_REFRESH_SECRET=secret_for_refresh
AUTH_REFRESH_TOKEN_EXPIRES_IN=30d
AUTH_UNIFORM_ERRORS=false

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
